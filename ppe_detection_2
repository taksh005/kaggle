   }\n\n        dropped, kept = 0, 0\n        for ann in raw['annotations']:\n            img_id = ann['image_id']\n            if img_id not in self.image_data:\n                continue\n            new_label = LABEL_REMAP.get(ann['category_id'])\n            if new_label is None:\n                dropped += 1\n                continue\n            kept += 1\n            ann = dict(ann)\n            ann['category_id'] = new_label\n            self.image_data[img_id]['annotations'].append(ann)\n\n        print(f\"[PPEDataset] Remapped annotations: kept={kept}, dropped={dropped}\")\n\n        valid_ext = {'.jpg', '.jpeg', '.png', '.bmp', '.tiff', '.tif', '.webp'}\n        self.image_ids = []\n        missing = 0\n        for img_id, info in self.image_data.items():\n            ext = Path(info['file_name']).suffix.lower()\n            if ext not in valid_ext:\n                continue\n            if not (self.image_dir / info['file_name']).exists():\n                missing += 1\n                continue\n            # Skip images that ended up with zero boxes after remap\n            if len(info['annotations']) == 0:\n                continue\n            self.image_ids.append(img_id)\n\n        print(f\"[PPEDataset] Usable images: {len(self.image_ids)} \"\n              f\"(missing files: {missing})\")\n\n        if len(self.image_ids) == 0:\n            raise ValueError(f\"No usable images found in {self.image_dir}\")\n\n    def __len__(self):\n        return len(self.image_ids)\n\n    def __getitem__(self, idx):\n        img_id = self.image_ids[idx]\n        info = self.image_data[img_id]\n\n        img_path = self.image_dir / info['file_name']\n        image = cv2.imread(str(img_path))\n        image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)\n\n        boxes, labels, areas, iscrowd = [], [], [], []\n        for ann in info['annotations']:\n            x, y, w, h = ann['bbox']\n            if w <= 0 or h <= 0:\n                continue\n            boxes.append(